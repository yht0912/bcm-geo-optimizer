{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yht0912/bcm-geo-optimizer/schemas/action-bundle.schema.json",
  "title": "BCM GEO Action Bundle",
  "description": "Evidence-linked planning actions. Their order is not proof of outcome impact.",
  "type": "object",
  "required": ["schema_version", "methodology", "study_id", "purpose", "actions"],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "methodology": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "bcm-geo-evidence-action-retest"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      },
      "additionalProperties": false
    },
    "study_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "action_id",
        "priority_class",
        "limiting_layer",
        "observed_gap",
        "evidence_ref",
        "evidence_strength",
        "impact",
        "reach",
        "effort",
        "risk",
        "reversibility",
        "expected_state",
        "acceptance_check"
      ],
      "properties": {
        "action_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "priority_class": {"enum": ["P0", "P1", "P2", "P3"]},
        "limiting_layer": {
          "enum": [
            "access",
            "discovery",
            "retrieval",
            "entity",
            "answerability",
            "corroboration",
            "recommendation_fit",
            "conversion"
          ]
        },
        "observed_gap": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_strength": {"type": "number", "minimum": 0, "maximum": 1},
        "impact": {"type": "number", "minimum": 1, "maximum": 5},
        "reach": {"type": "number", "minimum": 1, "maximum": 5},
        "effort": {"type": "number", "minimum": 1, "maximum": 5},
        "risk": {"type": "number", "minimum": 1, "maximum": 5},
        "reversibility": {"type": "number", "minimum": 1, "maximum": 5},
        "expected_state": {"type": "string", "minLength": 1, "maxLength": 100},
        "acceptance_check": {"type": "string", "minLength": 1, "maxLength": 4000}
      },
      "additionalProperties": false
    }
  }
}
